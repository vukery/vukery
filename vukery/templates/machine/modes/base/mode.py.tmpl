"""The base mode: runs for every ball and scores the playfield.

A mode is a folder: this file holds the class and its rules, and the files
next to it hold its parts (scoring.py here; add slides.py, and shows, as the
mode grows). A small mode can also be one file.
"""

from vukery import Mode, on

from .scoring import SCORING  # a file next to this one, in the same mode folder


class Base(Mode):
    priority = 100              # higher priorities handle switches first (and can block lower ones)
    start_on = "ball_started"   # starts with every ball; a game mode also stops when the ball ends
    scoring = SCORING           # what this mode scores (scoring.py)

    @on.switch("s_target")      # runs whenever the target is hit, alongside the scoring table
    def count_target(self):
        # Player variables are plain attributes, kept per player across balls.
        self.player.targets = self.player.get("targets", 0) + 1
